<?xml version="1.0"?>
<ruleset name="Abuobaida">
	<description>Coding standards for the abuobaida theme: WordPress Coding Standards 3 plus PHP compatibility.</description>

	<!-- What to scan. -->
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/vendor/*</exclude-pattern>
	<exclude-pattern>/docs/*</exclude-pattern>
	<!-- Local-development scripts (router, seed data) are not theme code. -->
	<exclude-pattern>/tools/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg value="ps"/>

	<!-- WordPress = WordPress-Core + WordPress-Docs + WordPress-Extra. -->
	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="abuobaida"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="abuobaida"/>
			</property>
		</properties>
	</rule>

	<!-- Template file names follow the template hierarchy, not class naming. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>

	<!-- Minimums for v2 (DECISIONS D-13). -->
	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
